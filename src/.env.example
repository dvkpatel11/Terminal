# ============================================================
# Environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is git-ignored.
# ============================================================

# ── Stocks ──────────────────────────────────────────────────
# Finnhub provides real-time and historical stock data.
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=

# ── News ────────────────────────────────────────────────────
# NewsAPI aggregates headlines. Optional — RSS feeds work without it.
# Free tier: https://newsapi.org/register
NEWSAPI_KEY=

# ── Social Sentiment ───────────────────────────────────────
# Twitter/X API v2 bearer token for social sentiment.
# https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# ── AI (Chat Agent) ────────────────────────────────────────
# NVIDIA NIM API for the chat agent.
# Get key: https://integrate.api.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=minimaxai/minimax-m3

# ── AI (Anthropic Claude) ──────────────────────────────────
# Claude API key for future thesis engine integration.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── AI (OpenRouter) ───────────────────────────────────────
# OpenRouter aggregates multiple LLM providers.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4

# ── Macro Economics ────────────────────────────────────────
# FRED API from the St. Louis Fed (GDP, CPI, unemployment, etc.)
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Options ────────────────────────────────────────────────
# CBOE data for put/call ratios and options flow.
CBOE_API_KEY=

# ── On-Chain (Crypto) ──────────────────────────────────────
# Glassnode for on-chain analytics.
GLASSNODE_API_KEY=
# Whale Alert for large crypto transactions.
# https://whale-alert.io/api
WHALE_ALERT_API_KEY=

# ── Trading (SnapTrade) ────────────────────────────────────
# SnapTrade connects brokerage accounts (read-only).
# https://dashboard.snaptrade.com/
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# ── OAuth Social Accounts ──────────────────────────────────
# Reddit OAuth2 for social feed (optional — public API also works).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X/Twitter OAuth2
X_CLIENT_ID=
X_CLIENT_SECRET=
# Truth Social OAuth2
TRUTH_CLIENT_ID=
TRUTH_CLIENT_SECRET=
# Base URL for OAuth redirects (default: http://localhost:3000)
OAUTH_REDIRECT_BASE=
# AES-256 key for encrypting stored OAuth tokens (32-byte hex string).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=

# ── AWS (Bedrock) ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# ── Server ─────────────────────────────────────────────────
# Simple bearer token protecting all /api/* routes.
API_TOKEN=
PORT=3000
